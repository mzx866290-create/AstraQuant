# Production environment template.
# Copy this file to your deployment secret manager or CI/CD environment.
# Do not commit real secrets in .env.production.

APP_ENV=production
AUTH_REQUIRED=true
USE_SQLITE=false
APP_IMAGE_REGISTRY=ghcr.io/your-org/stock-platform
APP_VERSION=<git-sha-or-semver>

# Database
DB_USER=stockadmin
DB_PASS=<set-by-secret-manager>
DB_HOST=postgres
DB_PORT=5432
DB_NAME=stock_platform

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=<set-by-secret-manager>

# Security
JWT_SECRET=<32-plus-character-random-secret>
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7
AI_ENCRYPTION_KEY=<fernet-key-from-cryptography>

# Password reset email
PUBLIC_APP_URL=https://your-domain.example
PASSWORD_RESET_EXPIRES_MINUTES=30
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<set-by-secret-manager>
SMTP_FROM=<no-reply@example.com>
SMTP_FROM_NAME=Stock Platform

# Data providers
CRAWLER_ENABLED=true
DATA_CRAWLER_ENABLE_SCHEDULED_NEWS=false
NEWS_CRAWL_COOLDOWN_SECONDS=300
AKSHARE_ENABLED=true
TUSHARE_TOKEN=<optional-secret>

# Ops
GRAFANA_PASS=<set-by-secret-manager>
# Real Feishu/DingTalk/Slack-compatible webhook URL, provided by the deployment environment.
ALERT_WEBHOOK_URL=<real-alert-webhook-url>
PROMETHEUS_RETENTION=15d
LOG_LEVEL=INFO
NEWS_PREFILTER_ENABLED=false
NEWS_PREFILTER_MODEL=glm-5
NEWS_PREFILTER_BASE_URL=https://openai.chatnewai.com
NEWS_PREFILTER_API_KEY=
NEWS_PREFILTER_TIMEOUT=45
NEWS_PREFILTER_MAX_RETRIES=0
NEWS_ENRICH_MODEL_NAME=grok-420-fast
NEWS_ENRICH_MODEL_ID=grok-420-fast
NEWS_ENRICH_PROVIDER=openai
NEWS_ENRICH_BASE_URL=https://openai.chatnewai.com
NEWS_ENRICH_API_KEY=
NEWS_ENRICH_REQUEST_TIMEOUT=90
NEWS_ENRICH_MAX_RETRIES=0
GLM_MODEL_ID=glm-5
GLM_BASE_URL=https://openai.chatnewai.com
GLM_API_KEY=
GLM_REQUEST_TIMEOUT=45
FRONTEND_URL=https://your-domain.example
VITE_API_BASE_URL=https://your-domain.example
