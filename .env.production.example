# Production environment template.
# Copy this file to your deployment secret manager or CI/CD environment.
# Do not commit real secrets in .env.production.

APP_ENV=production
AUTH_REQUIRED=true
USE_SQLITE=false
APP_IMAGE_REGISTRY=ghcr.io/your-org/stock-platform
APP_VERSION=<git-sha-or-semver>

# Database
DB_USER=stockadmin
DB_PASS=<set-by-secret-manager>
DB_HOST=postgres
DB_PORT=5432
DB_NAME=stock_platform

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=<set-by-secret-manager>

# Security
JWT_SECRET=<32-plus-character-random-secret>
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7
AI_ENCRYPTION_KEY=<fernet-key-from-cryptography>

# Data providers
CRAWLER_ENABLED=true
DATA_CRAWLER_ENABLE_SCHEDULED_NEWS=false
NEWS_CRAWL_COOLDOWN_SECONDS=300
AKSHARE_ENABLED=true
TUSHARE_TOKEN=<optional-secret>

# Ops
GRAFANA_PASS=<set-by-secret-manager>
# Real Feishu/DingTalk/Slack-compatible webhook URL, provided by the deployment environment.
ALERT_WEBHOOK_URL=<real-alert-webhook-url>
PROMETHEUS_RETENTION=15d
LOG_LEVEL=INFO
FRONTEND_URL=https://your-domain.example
VITE_API_BASE_URL=https://your-domain.example
