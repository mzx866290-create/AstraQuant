# ============================================
# 股票平台环境变量配置
# 复制此文件为 .env，然后根据环境修改
# ============================================

# 数据库配置
DB_USER=stockadmin
DB_PASS=changeme
DB_HOST=postgres
DB_PORT=5432
DB_NAME=stock_platform

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ClickHouse 配置
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# JWT 认证
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# AI API Key 加密密钥 (生产环境必须设置，用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成)
AI_ENCRYPTION_KEY=

# 日志级别
LOG_LEVEL=INFO

# 数据采集配置
CRAWLER_ENABLED=true
TUSHARE_TOKEN=your_tushare_token_here
AKSHARE_ENABLED=true

# Grafana 管理员密码
GRAFANA_PASS=admin

# API 配置
VITE_API_BASE_URL=http://localhost
