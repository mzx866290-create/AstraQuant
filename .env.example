# ============================================
# 股票平台环境变量配置
# 复制此文件为 .env，然后根据环境修改
# ============================================

APP_ENV=development

# 数据库配置
DB_USER=stockadmin
DB_PASS=
DB_HOST=postgres
DB_PORT=5432
DB_NAME=stock_platform

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ClickHouse 配置
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# JWT 认证
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30
AUTH_REQUIRED=true

# Password reset email
PUBLIC_APP_URL=http://localhost:5175
PASSWORD_RESET_EXPIRES_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Stock Platform

# 初始管理员账号（首次 init_db() 自动创建，幂等）
# 留空则不创建；已有数据库可用 python scripts/create_admin.py 手动创建
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=

# AI API Key 加密密钥 (生产环境必须设置，用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成)
AI_ENCRYPTION_KEY=

# 日志级别
LOG_LEVEL=INFO

# 数据采集配置
CRAWLER_ENABLED=true
TUSHARE_TOKEN=your_tushare_token_here
AKSHARE_ENABLED=true

# Grafana 管理员密码
GRAFANA_PASS=

# 调度器配置
DAILY_POOL_SCHEDULER_ENABLED=true
REVIEW_SCHEDULER_ENABLED=true
NEWS_PREFILTER_ENABLED=false
NEWS_PREFILTER_MODEL=glm-5
NEWS_PREFILTER_BASE_URL=https://openai.chatnewai.com
NEWS_PREFILTER_API_KEY=
NEWS_PREFILTER_TIMEOUT=45
NEWS_PREFILTER_MAX_RETRIES=0
NEWS_ENRICH_MODEL_NAME=grok-420-fast
NEWS_ENRICH_MODEL_ID=grok-420-fast
NEWS_ENRICH_PROVIDER=openai
NEWS_ENRICH_BASE_URL=https://openai.chatnewai.com
NEWS_ENRICH_API_KEY=
NEWS_ENRICH_REQUEST_TIMEOUT=90
NEWS_ENRICH_MAX_RETRIES=0
GLM_MODEL_ID=glm-5
GLM_BASE_URL=https://openai.chatnewai.com
GLM_API_KEY=
GLM_REQUEST_TIMEOUT=45

# API 配置
VITE_API_BASE_URL=http://localhost
FRONTEND_URL=http://localhost:5175
